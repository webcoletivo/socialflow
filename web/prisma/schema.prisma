generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("staff")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // incrementada ao trocar senha/papel, sair ou excluir: invalida sessões (JWT) antigas
  sessionVersion Int    @default(0) @map("session_version")

  // redatora responsável (carteira), redatora do post e responsável por pendências
  responsibleClients      Client[]      @relation("ClientResponsible")
  writtenPosts            Post[]        @relation("PostWriter")
  responsiblePendingItems PendingItem[]
  // designer responsável (carteira) e artes que a usuária marcou como feitas
  designedClients         Client[]      @relation("ClientDesigner")
  artDonePosts            Post[]        @relation("PostArtDoneBy")
  // posts que a usuária marcou como postados à mão
  postedPosts             Post[]        @relation("PostPostedBy")
  // configurações do sistema que a usuária salvou por último (ex.: modelo de IA de texto)
  updatedSettings         AppSetting[]  @relation("AppSettingUpdatedBy")
  // trilha de auditoria: ações sensíveis feitas pela usuária
  auditLogs               AuditLog[]    @relation("AuditLogActor")

  @@map("users")
}

model Client {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  // e-mail principal. SEM unicidade de propósito (20/10): pode repetir o e-mail de outro cliente em
  // qualquer plano (ex.: o e-mail da agência, ou a aprovação que vai para uma única pessoa).
  // O índice parcial antigo uq_clients_email_aprovacao foi removido em
  // system/migrations/2026-10-20-pacotes-gestao.sql.
  email         String
  plan          String    @default("sem_aprovacao")
  toneOfVoice   String?   @map("tone_of_voice")
  // override opcional: ID da pasta do cliente no Drive. Se vazio, busca pelo nome.
  driveFolderId String?   @map("drive_folder_id")
  // --- dados de onboarding (substitui o doc por cliente) ---
  tradeName     String?   @map("trade_name")     // nome fantasia
  website       String?
  city          String?                          // cidade - UF
  phone         String?                          // fixo
  whatsapp      String?
  facebookUrl   String?   @map("facebook_url")
  instagramUrl  String?   @map("instagram_url")
  // diretrizes de conteúdo (temas, hashtags, restrições, texto obrigatório nas artes, etc.)
  briefing      Json?
  // credenciais por rede (login/senha) — JSON CRIPTOGRAFADO (AES-GCM). Nunca em texto plano.
  credentialsEnc String?  @map("credentials_enc")
  // marca (p/ geração de arte por IA em clientes de gestão básica)
  logoUrl       String?   @map("logo_url")
  brandColor    String?   @map("brand_color") // hex, ex: #7c5cff
  // pacote de gestão (lib/content-packages): gestao_1 | gestao_2 | gestao_3_stories | gestao_reels |
  // basica (artes-base por IA) | completa (antigo, sem pacote — a tela pede para escolher um)
  tier          String    @default("completa")
  // pacote com carrossel: "semanal" | "quinzenal" (CHECK ck_clients_carousel_frequency)
  carouselFrequency String @default("quinzenal") @map("carousel_frequency")
  // pacote com reels: dia da semana dos reels, 1–5 = seg–sex; null sem reels (CHECK ck_clients_reels_weekday)
  reelsWeekday  Int?      @map("reels_weekday") @db.SmallInt
  // exibir dados de contato (phone/whatsapp/site/instagram) na arte gerada?
  showContacts  Boolean   @default(false) @map("show_contacts")
  // a agência agenda e publica? false = só produção: nenhum post entra na fila
  agencyPublishes Boolean @default(true) @map("agency_publishes")
  // e-mails adicionais (normalizados, sem o principal, máx 10; não são únicos entre clientes)
  extraEmails   String[]  @default([]) @map("extra_emails")
  status        String    @default("ativo") // ativo | pausado | encerrado (organizacional)
  statusChangedAt DateTime? @map("status_changed_at") @db.Timestamptz(6)
  segment       String? // CORR | CARE | COLETIVO
  // redatora responsável pelo cliente
  responsibleUserId String? @map("responsible_user_id") @db.Uuid
  // designer responsável pelo cliente (fila de artes em /design)
  designerUserId String?  @map("designer_user_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  responsible    User?     @relation("ClientResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  designer       User?     @relation("ClientDesigner", fields: [designerUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  socialAccounts SocialAccount[]
  schedules      Schedule[]
  posts          Post[]
  weeklyReviews  WeeklyReview[]
  pendingItems   PendingItem[]

  @@index([designerUserId], map: "idx_clients_designer")
  @@map("clients")
}

model SocialAccount {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  platform       String
  externalId     String    @map("external_id")
  accessTokenEnc String    @map("access_token_enc")
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(6)
  // refresh token (LinkedIn OAuth — Meta usa token de longa duração sem refresh)
  refreshTokenEnc       String?   @map("refresh_token_enc")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  dailyPostLimit Int       @default(25) @map("daily_post_limit")
  status         String    @default("active")
  // de qual conexão Meta esta conta foi importada (se aplicável)
  metaConnectionId String? @map("meta_connection_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  metaConnection MetaConnection? @relation(fields: [metaConnectionId], references: [id], onDelete: SetNull)

  @@index([clientId], map: "idx_accounts_client")
  @@index([tokenExpiresAt], map: "idx_tokens_expiring")
  @@map("social_accounts")
}

model MetaConnection {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  businessId     String?  @map("business_id")
  accessTokenEnc String   @map("access_token_enc") // System User token (criptografado)
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  socialAccounts SocialAccount[]

  @@map("meta_connections")
}

model Schedule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  monthRef  DateTime @map("month_ref") @db.Date
  // rascunho | aprovado_interno | enviado_cliente | em_revisao | aprovado_cliente
  status    String   @default("rascunho")
  approvalToken String?   @unique @map("approval_token") // link público de aprovação
  // comentário geral do cliente ao pedir ajustes (status vira em_revisao)
  clientNote    String?   @map("client_note")
  // quando o cliente pediu ajustes pela última vez (usado no fluxo de prazos)
  changesAskedAt DateTime? @map("changes_asked_at") @db.Timestamptz(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  posts  Post[]

  @@map("schedules")
}

model Post {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId  String?   @map("schedule_id") @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  theme       String?
  // breve explicação do tema (fase cronograma — é o que o cliente aprova)
  explanation String?
  caption     String?
  captions    Json?     // legenda por rede: { instagram?, facebook?, linkedin? }
  mediaUrl    String?   @map("media_url")
  mediaDriveId String?  @map("media_drive_id") // ID do arquivo no Google Drive (origem da mídia)
  // itens do carrossel (ordenados): [{ url, driveId, type }]. Single fica em mediaUrl.
  mediaItems  Json?     @map("media_items")
  // roteiro por tela (carrossel/reels): [{ text }] — conteúdo textual planejado de cada slide
  slides      Json?
  format      String    @default("feed") // feed | story | carrossel | reels
  // tipo do conteúdo no pacote de gestão (lib/content-packages CONTENT_KINDS); null = sem tipo
  contentKind String?   @map("content_kind")
  scheduledAt DateTime  @map("scheduled_at") @db.Timestamptz(6)
  targets     String[]
  status      String    @default("scheduled")
  aiEditsUsed Int       @default(0) @map("ai_edits_used") // regenerações IA na aprovação (máx 5)
  retryCount  Int       @default(0) @map("retry_count")
  lastError   String?   @map("last_error")
  // arte-base que originou este post (plano básico) — evita duplicar na regeração
  artTemplateId String? @map("art_template_id") @db.Uuid
  // "lembrança": miniatura (data URI jpeg ~15KB) gravada ao publicar; a mídia
  // cheia fica no R2 por 30 dias e depois é excluída (não ocupa Cloudflare)
  mediaThumb  String?   @map("media_thumb")
  // comentário do cliente pedindo ajuste neste post (link de aprovação)
  clientNote       String?   @map("client_note")
  // aprovação semanal do post completo pelo cliente ("aprovado" | null)
  clientApproval   String?   @map("client_approval")
  clientApprovedAt DateTime? @map("client_approved_at") @db.Timestamptz(6)
  weeklyReviewId   String?   @map("weekly_review_id") @db.Uuid
  // redatora do post
  writerId     String?   @map("writer_id") @db.Uuid
  // nota interna da equipe (ex.: "NÃO FAZER CAPA") — nunca aparece nas páginas públicas
  internalNote String?   @map("internal_note")
  // arte marcada como feita pela designer (null = não marcada; regra completa em lib/production.ts hasArt)
  artDoneAt    DateTime? @map("art_done_at") @db.Timestamptz(6)
  // quem marcou a arte como feita (users.id)
  artDoneBy    String?   @map("art_done_by") @db.Uuid
  // postado nas redes pela equipe e marcado à mão no calendário do Design (status vira "published")
  postedManuallyAt DateTime? @map("posted_manually_at") @db.Timestamptz(6)
  // quem marcou como postado (users.id)
  postedBy     String?   @map("posted_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  schedule     Schedule?     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  weeklyReview WeeklyReview? @relation(fields: [weeklyReviewId], references: [id], onDelete: SetNull)
  writer       User?         @relation("PostWriter", fields: [writerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  artDoneByUser User?        @relation("PostArtDoneBy", fields: [artDoneBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  postedByUser User?         @relation("PostPostedBy", fields: [postedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_posts_posted_by")
  publications Publication[]
  adjustments  PostAdjustment[]
  pendingItems PendingItem[]

  @@index([scheduledAt], map: "idx_posts_due")
  @@index([clientId], map: "idx_posts_client")
  @@index([artDoneAt], map: "idx_posts_art_done_at")
  @@map("posts")
}

// Pedido de ajuste do cliente em um post (fase cronograma OU semanal).
// Enquanto houver ajuste "pendente" no cronograma, a aprovação fica bloqueada.
model PostAdjustment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId     String    @map("post_id") @db.Uuid
  comment    String
  status     String    @default("pendente") // pendente | resolvido
  reply      String? // resposta da redatora ao resolver
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId], map: "idx_adjustments_post")
  @@index([status], map: "idx_adjustments_status")
  @@map("post_adjustments")
}

// Pendências e stand-by: posts sem data, aguardando material do cliente,
// avulsos. Não usa Post.scheduledAt nulo — o post só nasce ao converter.
model PendingItem {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String    @map("client_id") @db.Uuid
  postId            String?   @map("post_id") @db.Uuid
  kind              String    @default("stand_by") // stand_by | aguardando_material | avulso | outro
  title             String
  details           String?
  responsibleUserId String?   @map("responsible_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  post        Post?  @relation(fields: [postId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  responsible User?  @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([clientId], map: "idx_pending_items_client")
  @@index([resolvedAt], map: "idx_pending_items_resolved")
  @@map("pending_items")
}

// Link semanal de aprovação de posts completos (título + legenda + arte),
// enviado quarta/quinta com os posts da semana seguinte.
model WeeklyReview {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String    @map("client_id") @db.Uuid
  token      String    @unique
  weekStart  DateTime  @map("week_start") @db.Date // domingo da semana revisada
  status     String    @default("enviado") // enviado | concluido
  sentAt     DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  posts  Post[]

  @@unique([clientId, weekStart], map: "uq_weekly_client_week")
  @@map("weekly_reviews")
}

// Trilha de notificações/alertas (equipe e cliente) — nada passa despercebido.
// dedupeKey evita alerta duplicado no mesmo dia (ex: "sem-resposta:<postId>:2026-09-10").
model Alert {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind      String // prazo_cronograma | ajuste_solicitado | ajuste_resolvido | cronograma_auto_aprovado | sem_resposta | sem_arte | semanal_enviado
  audience  String // equipe | cliente
  message   String
  clientId  String?   @map("client_id") @db.Uuid
  scheduleId String?  @map("schedule_id") @db.Uuid
  postId    String?   @map("post_id") @db.Uuid
  dedupeKey String    @unique @map("dedupe_key")
  emailed   Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_alerts_created")
  @@map("alerts")
}

model Publication {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId         String    @map("post_id") @db.Uuid
  platform       String
  externalPostId String?   @map("external_post_id")
  status         String    @default("pending")
  error          String?
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("publications")
}

// Arte-base para geração por IA (gestão básica). Versionada por período;
// a IA edita esta imagem aplicando cor/logo/tema do cliente.
model ArtTemplate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   // título da arte (tema da postagem)
  month        String?  // "YYYY-MM" (campanha do mês), opcional
  // agenda no calendário do plano básico (dia do mês + hora SP "HH:mm")
  day          Int?
  time         String?  @default("18:00")
  // legendas padronizadas (mesmas p/ todos os clientes básicos): { shared, linkedin }
  captions     Json?
  baseImageUrl String   @map("base_image_url")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("art_templates")
}

// Resumo diário gerado por IA para a dashboard (1 por dia, fuso SP).
model DailySummary {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day       String   @unique // "YYYY-MM-DD" no fuso America/Sao_Paulo
  content   String
  postCount Int      @default(0) @map("post_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("daily_summaries")
}

// Configurações do sistema (chave → valor JSON), editadas em Administração.
// Hoje: "ai.textModel" = { provider: "google", model: "<id>" | null } — modelo de IA de
// texto (null/sem linha = padrão do sistema). Ver web/src/lib/ai-models.ts.
// Migração: system/migrations/2026-10-07-app-settings.sql
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  updater   User?    @relation("AppSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("app_settings")
}

// Trilha de auditoria: ações sensíveis (revelar credencial, trocar papel, excluir
// cliente/posts, trocar conta de publicação, configurações de IA…). Somente inserção.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(6)
  actorId    String?  @map("actor_id") @db.Uuid
  actorEmail String?  @map("actor_email")
  action     String // ex.: credential.reveal, user.role_change, client.delete
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  clientId   String?  @map("client_id") @db.Uuid
  meta       Json?
  ip         String?

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([at], map: "idx_audit_log_at")
  @@index([action], map: "idx_audit_log_action")
  @@index([clientId], map: "idx_audit_log_client")
  @@map("audit_log")
}
